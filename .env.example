# Variables de entorno para Naranja Mandarina
# Copia este archivo a .env para desarrollo local
# En Netlify, configura estas variables en: Site settings > Environment variables

# Emails autorizados como administradores (separados por coma, sin espacios)
AUTHORIZED_EMAILS=manueltutalcha@gmail.com,jennytutalcha83@gmail.com

# Secret para token admin HMAC (genera uno seguro en producción)
# Puedes usar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=tu-admin-secret-aqui

# Secret para sesiones (genera uno aleatorio en producción)
SESSION_SECRET=tu-session-secret

# Configuración de envío de emails (Resend recomendado)
# Obtén tu API key en: https://resend.com/api-keys
RESEND_API_KEY=re_tu_api_key_aqui
# Email del remitente (debe estar verificado en Resend)
EMAIL_FROM=noreply@tudominio.com

# (OPCIONAL) Email de seguridad centralizado para recibir TODOS los tokens
# Si se define, los códigos de recuperación se enviarán SOLO a este correo
SECURITY_EMAIL=seguridad@tudominio.com

# Modo solo administradores (true = solo emails autorizados pueden acceder)
PUBLIC_AUTH_DISABLED=true

# Entorno (development o production)
NODE_ENV=development

# URL del sitio (en Netlify se detecta automáticamente como variable de sistema)
# URL=https://tu-sitio.netlify.app
