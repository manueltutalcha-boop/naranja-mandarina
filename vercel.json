{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/balacas", "destination": "/balacas.html" },
    { "source": "/accesorios", "destination": "/accesorios.html" },
    { "source": "/blusas", "destination": "/blusas.html" },
    { "source": "/faldas", "destination": "/faldas.html" },
    { "source": "/vestidos", "destination": "/vestidos.html" },
    { "source": "/banos", "destination": "/banos.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://nuzwirezbyrgbougzhlv.supabase.co; connect-src 'self' https://nuzwirezbyrgbougzhlv.supabase.co wss://nuzwirezbyrgbougzhlv.supabase.co; frame-ancestors 'none'; object-src 'none'; base-uri 'self';"
        },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
