{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/balacas", "destination": "/balacas.html" },
    { "source": "/accesorios", "destination": "/accesorios.html" },
    { "source": "/blusas", "destination": "/blusas.html" },
    { "source": "/faldas", "destination": "/faldas.html" },
    { "source": "/vestidos", "destination": "/vestidos.html" },
    { "source": "/banos", "destination": "/banos.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
